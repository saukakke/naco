{
  "name": "saukakke/naco-portal-backend",
  "type": "project",
  "description": "NACO personnel management portal backend",
  "license": "proprietary",
  "require": {"php":"^8.2","laravel/framework":"^12.0","laravel/sanctum":"^4.0","laravel/tinker":"^2.10"},
  "require-dev": {"fakerphp/faker":"^1.23","laravel/pail":"^1.2","laravel/pint":"^1.24","laravel/sail":"^1.41","mockery/mockery":"^1.6","nunomaduro/collision":"^8.6","phpunit/phpunit":"^11.5"},
  "autoload": {"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{"post-autoload-dump":["@php artisan package:discover --ansi"],"test":["@php artisan config:clear","@php artisan test"]},
  "extra":{"laravel":{"dont-discover":[]}},"minimum-stability":"stable","prefer-stable":true
}
